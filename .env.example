# ---- Supabase (required) ----
# Project URL and publishable (anon) key: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Postgres connection string for the server and the sync pipeline.
# Dashboard → Connect → "Transaction pooler" (port 6543). Session mode (5432)
# only allows 15 clients and holds one per connection, which serverless
# functions exhaust immediately; a pooler URL on 5432 is moved to 6543
# automatically, and SUPABASE_DB_KEEP_PORT=1 opts out of that.
# Contains the database password, so keep it server-side only.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# ---- Optional ----
# Shared secret that lets a scheduler (Vercel Cron / GitHub Actions) call
# POST /api/sync without a user session.
# CRON_SECRET=some-long-random-string

# USAJOBS is the only federal source that requires a key, and it is the one that
# carries NIH, CDC, FDA and VA student openings plus the government-wide Pathways
# Internship Program. The key is free: https://developer.usajobs.gov/apirequest/
# The email is the one you registered with; USAJOBS expects it as the User-Agent.
# Without both values the usajobs source stays quiet instead of erroring.
# USAJOBS_API_KEY=your-usajobs-api-key
# USAJOBS_EMAIL=you@example.com
